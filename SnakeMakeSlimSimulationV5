def make_rep_inputs(w):
    """
    Return list of input files for NRep  based on output wildcards.
    """
    pattern = (
        outputDir
        + "IntroInv_XYsyst_{Size}M_{Chrom}_N{N}_r{r}_u{u}_s{s}_h{h}_sInv{sInv}_invSize{invSize}_AllRep/"
        + "IntroInv_XYsyst_{Size}M_{Chrom}_N{N}_r{r}_u{u}_"
        + "s{s}_h{h}_sInv{sInv}_invSize{invSize}_Rep{Rep}_Stat.txt"
    )
    return expand(
        pattern,
        Rep=range(1, int(w.NRep) + 1),   # Rep 0..10000
        #Rep=range(1, 5),   # Rep 0..10000
        Chrom=w.Chrom,
        Size=w.Size,
        N=w.N,
        r=w.r,
        u=w.u,
        s=w.s,
        h=w.h,
        sInv=w.sInv,
        invSize=w.invSize
    )

rule MergeSimulations:
    input:
        make_rep_inputs
    output:
        Sim= outputDir + "IntroInv_XYsyst_{Size}M_{Chrom}_N{N}_r{r}_u{u}_s{s}_h{h}_sInv{sInv}_invSize{invSize}_All{NRep}Rep_Stat.txt"
