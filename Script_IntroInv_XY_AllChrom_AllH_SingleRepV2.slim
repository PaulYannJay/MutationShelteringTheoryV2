// set up a simple neutral simulation
initialize() { // set the overall mutation rate
	defineConstant("rho", r);
	defineConstant("u", mu);
	defineConstant("Ne", N);
	initializeMutationRate(u);
	// Mutation type // Rescaled for population 10 time smaller
    if ( isFloat(h) | isInteger(h) ) 
        {
        print('soso');
        initializeMutationType("m10", h, "f", s);
        initializeMutationType("m2", 0.5, "f", 0);// mutation defining mating type locus 1
        initializeMutationType("m4", 0.5, "f", sInv);// mutation defining inversion 1
	    initializeGenomicElementType("g1", c(m10), c(100));
        }
    else if (h == "Distrib1")
        {
        initializeMutationType("m10", 0.0, "f", s);
        initializeMutationType("m101", 0.01, "f", s);
        initializeMutationType("m11", 0.1, "f", s);
        initializeMutationType("m12", 0.2, "f", s);
        initializeMutationType("m13", 0.3, "f", s);
        initializeMutationType("m14", 0.4, "f", s);
        initializeMutationType("m15", 0.5, "f", s);
        initializeMutationType("m2", 0.5, "f", 0);// mutation defining mating type locus 1
        initializeMutationType("m4", 0.5, "f", sInv);// mutation defining inversion 1
        // g1 genomic element type: uses m1 for all mutations
        initializeGenomicElementType("g1", c(m10,m101,m11,m12,m13,m14,m15), c(100,100,100,100,100,100,100));
        }
    else if (h == "Distrib2")
        {
        initializeMutationType("m10", 0.1, "f", s);
        initializeMutationType("m12", 0.2, "f", s);
        initializeMutationType("m13", 0.3, "f", s);
        initializeMutationType("m14", 0.4, "f", s);
        initializeMutationType("m15", 0.5, "f", s);
        initializeMutationType("m2", 0.5, "f", 0);// mutation defining mating type locus 1
        initializeMutationType("m4", 0.5, "f", sInv);// mutation defining inversion 1
        // g1 genomic element type: uses m1 for all mutations
        initializeGenomicElementType("g1", c(m10,m12,m13,m14,m15), c(100,100,100,100,100));
        }

	defineConstant("ChromLength",chromSize );
    sizeMb=integerDiv(chromSize,1000000);
	defineConstant("midPos", integerDiv(ChromLength,2));
	// uniform chromosome of length 2000 kb for two chromosome
	initializeGenomicElement(g1, 0,ChromLength-1);
    if (Chrom == "SexChrom")
        {
        defineConstant("NcheckChild",12*N);
        }
    else
        {
        defineConstant("NcheckChild",6*N);
        }
	// uniform recombination along two chromosomes
	rates=c(rho);//Two chromosomes 
    ends=c(ChromLength-1); //Two chromosome of size 2000000 and 1	
	initializeRecombinationRate(rates, ends);
	initializeSex("A");
	defineConstant("simID", getSeed());
    Endtime=6*N;
	defineConstant("startInv",midPos-integerDiv(InvSize,2));
	defineConstant("endInv",midPos+integerDiv(InvSize,2));
  defineConstant("file", "Output/IntroInv_XYsyst_"+ sizeMb + "M_" + Chrom + "_N" + N + "_r" + r + "_u" + mu + "_s" + s +"_h" + h + "_sInv" + sInv + "_invSize" + InvSize +"_AllRep/IntroInv_XYsyst_"+ sizeMb + "M_" + Chrom + "_N" + N + "_r" + r + "_u" + mu + "_s" + s +"_h" + h + "_sInv" + sInv +"_invSize" + InvSize + "_Rep" + Rep + "_Stat.txt");
	}

//(6*N ) early() {
//	defineConstant("pos",start+integerDiv(end-start,2)); //Pos, the position of the inversion marker, must be an integer. Here, I use integerDiv to calculate the middle of the position of the inversion and define it as an integer
//	defineConstant("sizeInv",endInv-startInv); //The size of the inversion : used for output printing
//}

(6*N ) early() { //using late() just to avoid drift the first generation
	sim.readFromPopulationFile(Init); //Read the initial population file
	setSeed(rdunif(1, 0, asInteger(2^62) - 1));
	i = p1.individuals;
    if (Chrom == "SexChrom")
        {
	    i[i.sex == "M"].genome2.addNewDrawnMutation(m2, midPos); //Introduce the sex mutation
        Sample=sample(i[i.sex == "M"].genome2, 1);
	    Sample.addNewDrawnMutation(m4, midPos); //introduce a new inversion
        }
    else
        {
//	    i.genome2.addNewDrawnMutation(m2, midPos); //Introduce the sex mutation /ATTTTTTTENNTIONNNNNNN, Je ne sais pas ce que ca fait. A re reflechir !!!
        Sample=sample(p1.genomes, 1);
	    Sample.addNewDrawnMutation(m4, midPos); //introduce a new inversion
        community.deregisterScriptBlock(s1);
        }
	}

/////////////////////////////////////////////////// HERE --> What to do if Chrom is not Sex //////////////////
s1 (6*N):(NcheckChild)	modifyChild(p1) { //simulating the meeting between two gamete and fecondation depand on their genotype
	numY = sum(child.genomes.containsMarkerMutation(m2, midPos)); // no individual should have more than one Y //	if (numY > 1)
//		stop("### ERROR: got too many Ys");
	// females should have 0 Y's
	if (child.sex == "F" & numY > 0)
		return F;
	// males should have 1 Y
	if (child.sex == "M" & numY == 0)
		return F;
	return T;
}


(6*N):(12*N) early() { //record inversion frequency 
	mut4 = sim.mutationsOfType(m4);//inversion marker
	if (sim.cycle % 10 == 0 | sim.cycle==(6*N+1)) //every 10 generation
		{
		if (size (mut4) != 1) // If their is no more inversion segregating in the population (i.e. the inversion get fixed or Lost)
		{
    //        print("siso");
			sim.simulationFinished(); // The simulaten end when their is no more inversion segregating
		}
		else
		{
		Freq4=sim.mutationFrequencies(NULL, mut4);
		VecMut=p1.genomes.containsMarkerMutation(m4,midPos);//vector of boolean depending on whether genomes contain the inversion
		genomeWInv=p1.genomes[VecMut]; // genomes with inversion
		genomeNoInv=p1.genomes[!VecMut];//genomes without inversion
		//genome no Inv
		NMutNoInvvec=c(); //vector containg the number of mutations in indiv without inversion
		FreqMutNoInvvec=c(); //mean frequency of these mutations
		SampAnal=0;
		for (g in genomeNoInv) { //For all genomes without the inversion
			if (SampAnal>=100){ //Analyse at maximum 100 genomes
				break;}
			Mut10=g.mutationsOfType(m10);
			mut = c(Mut10);
			posMut = mut.position; //position of mutation in this genome
			NbMut=sum((posMut >= startInv) & (posMut < endInv)); //Number of mutation in the inversion region
			NMutNoInvvec=c(NMutNoInvvec, NbMut); //put in a vector
			MutNoInvBool=((posMut >= startInv) & (posMut < endInv));
    		MutNoInv=mut[MutNoInvBool];
    		MutNoInvFreq=mean(sim.mutationFrequencies(NULL, MutNoInv)); //Mean frequency of mutation in the inversion
			FreqMutNoInvvec=c(FreqMutNoInvvec, MutNoInvFreq); //put in a vector
			SampAnal=SampAnal+1;
			}
		meanNbMutNoInv=mean(NMutNoInvvec); //mean number of mutations in non-inverted segments
		sdNbMutNoInv=sd(NMutNoInvvec); // sd
		maxNbMutNoInv=max(NMutNoInvvec); //max
		minNbMutNoInv=min(NMutNoInvvec); //min
		if( size(FreqMutNoInvvec)>0)
			{
			meanFreqMutNoInv=mean(FreqMutNoInvvec);
			}
		else
			{
			meanFreqMutNoInv="NA";
			}
		// genome with Inv
		NMutWInvvec=c();
		FreqMutWInvvec=c();
		SampAnal=0;
		for (g in genomeWInv) { //For all genomes with the inversion
			if (SampAnal>=100){ //Analyse at maximum 100 genomes
				break;}
			Mut10=g.mutationsOfType(m10);
			mut = c(Mut10);
			posMut = mut.position; //position of mutation in this genome
			NbMut=sum((posMut >= startInv) & (posMut < endInv)); //Number of mutation in the inversion region
			NMutWInvvec=c(NMutWInvvec, NbMut); //put in a vector
			MutWInvBool=((posMut >= startInv) & (posMut < endInv));
    		MutWInv=mut[MutWInvBool];
    		MutWInvFreq=mean(sim.mutationFrequencies(NULL, MutWInv)); //Mean frequency of mutation in the inversion
			FreqMutWInvvec=c(FreqMutWInvvec, MutWInvFreq); //put in a vector
			SampAnal=SampAnal+1;
			}
		meanNbMutWInv=mean(NMutWInvvec); //mean number of mutation in inverted segment
		if (size(NMutWInvvec) > 1)
		{ sdNbMutWInv=sd(NMutWInvvec);} //sd
		else
		{sdNbMutWInv=0;}
		maxNbMutWInv=max(NMutWInvvec); //max
		minNbMutWInv=min(NMutWInvvec); //min
		if( size(FreqMutWInvvec)>0)
			{
			meanFreqMutWInv=mean(FreqMutWInvvec); //mean frequency of mutations
			}
		else
			{
			meanFreqMutWInv="NA";
			}

    	meanFitnessInv=mean(p1.cachedFitness(genomeWInv.individual.index)); //Mean Fitness of sample with inversion
    	meanFitnessNoInv=mean(p1.cachedFitness(genomeNoInv.individual.index));//Mean Fitness of sample without inversion
		line=paste(c(N, mu,r,h,s,sInv,sim.cycle,startInv,endInv,Rep,Chrom,meanNbMutWInv, minNbMutWInv, maxNbMutWInv, sdNbMutWInv, meanFreqMutWInv,meanNbMutNoInv, minNbMutNoInv, maxNbMutNoInv, sdNbMutNoInv, meanFreqMutNoInv,meanFitnessInv,  meanFitnessNoInv, Freq4), sep="\t"); //output
		writeFile(file, line, append=T);
        if (Chrom == "SexChrom")
            {
	        if (Freq4 >= 0.25) // If the inversion is fixed in the population of Y chromosome 
		        {
		    	sim.simulationFinished(); // The simulaten end when their is no more inversion segregating
		        }
            }
        }
	}
}

(12*N) late() {
	sim.simulationFinished();
}

recombination() { //Define special recombination pattern depending on mutation (inversion) presence
	if (genome1.containsMarkerMutation(m4, midPos) == genome2.containsMarkerMutation(m4, midPos)) //if the inversion marker is found in the two genome
		{return F;} //Nothing happens
	else //inversion heterozygote
		{ 
		inInv = (breakpoints > startInv) & (breakpoints < endInv); //Define breakpoint of inversion
		if (!any(inInv)) //If no recombination breakpoint fall in the inversion breakpoint, 
			{return F;} // Nothing happens
		else 
			{breakpoints = breakpoints[!inInv]; //If not, this recombination can't occur
			return T;
			}
		}

	}
