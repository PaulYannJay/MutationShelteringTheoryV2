// set up a simple neutral simulation
initialize() {
	// set the overall mutation rate
	defineConstant("rho", r);
	defineConstant("u", mu);
	defineConstant("Ne", N);
	initializeMutationRate(u);
	// Mutation type // Rescaled for population 10 time smaller
    if ( isFloat(h) | isInteger(h) ) 
        {
        print('soso');
        initializeMutationType("m10", h, "f", s);
        initializeMutationType("m2", 0.5, "f", 0);// mutation defining mating type locus 1
        initializeMutationType("m4", 0.5, "f", 0);// mutation defining inversion 1
	    initializeGenomicElementType("g1", c(m10), c(100));
        }
    else if (h == "Distrib1")
        {
        initializeMutationType("m10", 0.0, "f", s);
        initializeMutationType("m101", 0.01, "f", s);
        initializeMutationType("m11", 0.1, "f", s);
        initializeMutationType("m12", 0.2, "f", s);
        initializeMutationType("m13", 0.3, "f", s);
        initializeMutationType("m14", 0.4, "f", s);
        initializeMutationType("m15", 0.5, "f", s);
        initializeMutationType("m2", 0.5, "f", 0);// mutation defining mating type locus 1
        initializeMutationType("m4", 0.5, "f", 0);// mutation defining inversion 1
        // g1 genomic element type: uses m1 for all mutations
        initializeGenomicElementType("g1", c(m10,m101,m11,m12,m13,m14,m15), c(100,100,100,100,100,100,100));
        }
    else if (h == "Distrib2")
        {
        initializeMutationType("m10", 0.1, "f", s);
        initializeMutationType("m12", 0.2, "f", s);
        initializeMutationType("m13", 0.3, "f", s);
        initializeMutationType("m14", 0.4, "f", s);
        initializeMutationType("m15", 0.5, "f", s);
        initializeMutationType("m2", 0.5, "f", 0);// mutation defining mating type locus 1
        initializeMutationType("m4", 0.5, "f", 0);// mutation defining inversion 1
        // g1 genomic element type: uses m1 for all mutations
        initializeGenomicElementType("g1", c(m10,m12,m13,m14,m15), c(100,100,100,100,100));
        }
	//initializeMutationType("m2", 0.5, "e", 0.01*RescaleFactor);
	// g1 genomic element type: uses m1 for all mutations
	//initializeGenomicElementType("g1", c(m10,m101,m11,m12,m13,m14,m15,m2), c(100,100,100,100,100,100,100,0.1));
	


	// uniform chromosome of length 2000 kb for two chromosome
	initializeGenomicElement(g1, 0,4999999);


	// uniform recombination along two chromosomes
	rates=c(rho);//Two chromosomes 
    ends=c(4999999); //Two chromosome of size 2000000 and 1	
	initializeRecombinationRate(rates, ends);
	initializeSex("A");
	defineConstant("simID", getSeed());
	defineConstant("Endtime", 6*N);
	defineConstant("OutFileMut", "./InitialState/slim_g" + Endtime + "_XYsyst_5M_Autosome_N" + N + "_r" + r + "_u" +  mu + "_s" + s + "_h" + h + "_Rep" + Rep +"_" + simID + "_MutFreq.txt");
}

// create a population of 12500 individuals
1 late(){
	sim.addSubpop("p1", Ne);
}

1:(6*N) late(){
	if (sim.cycle % 100 == 0) //print output every 100 generation
		{
		print(sim.cycle);
		Genomes=p1.genomes; // All genomes 
		NMutVec=c();
		for (g in Genomes) {
			NbMut=g.countOfMutationsOfType(m10);
			NMutVec=c(NMutVec, NbMut);
			}
		meanNbMut=mean(NMutVec); //mean number of mutations in genomes
		mut1 = sim.mutationsOfType(m10); 
		Nmut1= sim.countOfMutationsOfType(m10); //Number of mutations segregating
		Freq1=sim.mutationFrequencies(NULL, mut1); //mean frequency of mutations
		MeanFreq1=mean(Freq1);
		line=paste(c(N, mu,r,s,sim.cycle,"Autosome",Rep, meanNbMut, Nmut1,  MeanFreq1), sep="\t"); //output the frequency of a given mutation
		writeFile(OutFileMut, line, append=T);
		}	
    if (sim.cycle % 100000 == 0)
    {
    sim.outputFull("./InitialState/slim_g" + sim.cycle + "_XYsyst_5M_Autosome_N" + N + "_r" + r + "_u" + mu + "_s" + s + "_h" + h + "_Rep" + Rep+ "_"+ simID + "ProgressPop.txt");
    }
	}

(6*N) late() {
sim.outputFull("./InitialState/slim_g" + Endtime + "_XYsyst_5M_Autosome_N" + N + "_r" + r + "_u" + mu + "_s" + s + "_h" + h + "_Rep" + Rep+ "_"+ simID + ".txt");
sim.simulationFinished();
}
